{
  "opencollection": "1.0.0",
  "info": {
    "name": "xMatters REST Devices Services API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Services",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{company}.{deployment}.xmatters.com/api/xm/1/services"
          },
          "docs": "List services"
        },
        {
          "info": {
            "name": "Create a service",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{company}.{deployment}.xmatters.com/api/xm/1/services"
          },
          "docs": "Create a service"
        }
      ]
    }
  ],
  "bundled": true
}