{
  "opencollection": "1.0.0",
  "info": {
    "name": "xMatters REST Devices Integrations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List integrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{company}.{deployment}.xmatters.com/api/xm/1/integrations"
          },
          "docs": "List integrations"
        },
        {
          "info": {
            "name": "Create an integration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{company}.{deployment}.xmatters.com/api/xm/1/integrations"
          },
          "docs": "Create an integration"
        }
      ]
    }
  ],
  "bundled": true
}